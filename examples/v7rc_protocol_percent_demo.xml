<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="v7rc_setup" x="30" y="30">
    <statement name="statement">
      <block type="v7rc_begin">
        <value name="UART_ID">
          <shadow type="math_number">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="RX">
          <shadow type="math_number">
            <field name="NUM">5</field>
          </shadow>
        </value>
        <value name="BAUD">
          <shadow type="math_number">
            <field name="NUM">115200</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>
  <block type="loopProcess" x="30" y="230">
    <statement name="statement">
      <block type="v7rc_update"></block>
    </statement>
  </block>
</xml>
